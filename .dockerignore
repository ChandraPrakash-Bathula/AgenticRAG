# The Dockerfile sits at the repo root, so THIS is the file Docker reads. Without it the
# build context is ~1.7 GB of dependencies that both stages reinstall anyway, and on a
# Hugging Face Space that whole context is uploaded to the builder first.

# Dependencies, reinstalled by npm ci and pip in the image
**/node_modules
**/.venv
**/venv
**/__pycache__
**/*.pyc

# Build output, regenerated by the web stage
frontend/dist

# Secrets. The Space supplies GROQ_API_KEY as a secret, never as a baked layer.
**/.env
**/.env.*

# Caches and OS cruft
**/.pytest_cache
**/.DS_Store
.git
.github

# Not part of the running app
Human_Nutrition.pdf
paper.tex
*.pptx
exercises
